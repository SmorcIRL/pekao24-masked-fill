{
  "manifest_version": 3,
  "name": "Pekao24 masked password fill",
  "version": "1",
  "action": { "default_popup": "popup.html" },
  "permissions": ["scripting", "clipboardWrite"],
  "host_permissions": ["https://*.pekao24.pl/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'"
  }
}
